    {"case_id": "authority_non_substitution", "expected": "fail_closed"},
    {"case_id": "stale_governance_head", "expected": "fail_before_adapter"},
    {"case_id": "revoked_grant", "expected": "fail_before_adapter"},
    {"case_id": "expired_grant", "expected": "fail_before_adapter"},
    {"case_id": "foreign_product", "expected": "fail_before_adapter"},
    {"case_id": "destination_drift", "expected": "fail_before_adapter"},
    {"case_id": "consent_revoked", "expected": "fail_before_adapter"},
    {"case_id": "entitlement_revoked", "expected": "fail_before_adapter"},
    {"case_id": "redaction_mismatch", "expected": "fail_before_adapter"},
    {"case_id": "payload_mismatch", "expected": "fail_before_adapter"},
    {"case_id": "ack_mismatch", "expected": "fail_closed"},
    {"case_id": "delivery_timeout", "expected": "unknown_result_lookup_required"},

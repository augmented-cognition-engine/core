# Private local runtime configuration generated by `ace setup`.
SURREAL_URL=ws://localhost:8001
SURREAL_NS=ace
SURREAL_DB=ace
SURREAL_USER=root
SURREAL_PASS=root

# `ace setup` replaces these placeholders with private random values.
JWT_SECRET=replace-me-with-32-byte-hex-string
API_KEY=local-dev-only-not-a-secret

# `ace setup --provider ...` configures one of these provider routes.
LLM_API_KEY=sk-test-placeholder
LLM_MODEL=claude-sonnet-5
LLM_BUDGET_MODEL=claude-haiku-4-5-20251001
LLM_REASONING_MODEL=claude-opus-4-8
LLM_FRONTIER_MODEL=claude-fable-5
LLM_BUDGET_EFFORT=default
LLM_EFFORT=default
LLM_REASONING_EFFORT=high
LLM_FRONTIER_EFFORT=xhigh

# Optional local runtime isolation. Export these before setup to persist them.
# COMPOSE_PROJECT_NAME=ace_local
# ACE_SURREAL_HOST_PORT=18041

# Optional local embedding/provider defaults.
EMBEDDING_PROVIDER=onnx
REQUIRE_SUBSCRIPTION=0
ENABLE_LEGACY_PRODUCT_INTELLIGENCE=false

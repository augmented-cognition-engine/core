-- Lane F0: epistemic relationship assertions and deterministic operational projection.
DEFINE TABLE IF NOT EXISTS relationship_proposal SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS subject ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS predicate ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS object ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS subject_type ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS object_type ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS polarity ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS scope ON relationship_proposal TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS valid_from ON relationship_proposal TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS valid_to ON relationship_proposal TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS evidence_refs ON relationship_proposal TYPE array<string>;
DEFINE FIELD IF NOT EXISTS source_records ON relationship_proposal TYPE array<string>;
DEFINE FIELD IF NOT EXISTS assumptions ON relationship_proposal TYPE array<string>;
DEFINE FIELD IF NOT EXISTS rationale ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS proposal_confidence ON relationship_proposal TYPE float;
DEFINE FIELD IF NOT EXISTS evidence_strength ON relationship_proposal TYPE option<float>;
DEFINE FIELD IF NOT EXISTS provenance_quality ON relationship_proposal TYPE option<float>;
DEFINE FIELD IF NOT EXISTS freshness ON relationship_proposal TYPE option<float>;
DEFINE FIELD IF NOT EXISTS origin_type ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS proposer ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS model ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS provider ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS workflow ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS prompt_version ON relationship_proposal TYPE option<string>;
DEFINE FIELD IF NOT EXISTS ontology_version ON relationship_proposal TYPE string;
DEFINE FIELD IF NOT EXISTS metadata ON relationship_proposal TYPE object FLEXIBLE;
DEFINE INDEX IF NOT EXISTS idx_relationship_proposal_semantic ON relationship_proposal FIELDS subject, predicate, object;

DEFINE TABLE IF NOT EXISTS relationship_assertion SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS subject ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS predicate ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS object ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS family ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS polarity ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS scope ON relationship_assertion TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS valid_from ON relationship_assertion TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS valid_to ON relationship_assertion TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS status ON relationship_assertion TYPE string ASSERT $value INSIDE ['proposed','provisional','accepted','contested','rejected','superseded','stale','retired'];
DEFINE FIELD IF NOT EXISTS proposal_confidence ON relationship_assertion TYPE float;
DEFINE FIELD IF NOT EXISTS evidence_strength ON relationship_assertion TYPE float;
DEFINE FIELD IF NOT EXISTS resolver_certainty ON relationship_assertion TYPE float;
DEFINE FIELD IF NOT EXISTS provenance_quality ON relationship_assertion TYPE float;
DEFINE FIELD IF NOT EXISTS freshness ON relationship_assertion TYPE float;
DEFINE FIELD IF NOT EXISTS evidence_refs ON relationship_assertion TYPE array<string>;
DEFINE FIELD IF NOT EXISTS supporting_assertions ON relationship_assertion TYPE array<string>;
DEFINE FIELD IF NOT EXISTS contradicting_assertions ON relationship_assertion TYPE array<string>;
DEFINE FIELD IF NOT EXISTS assumptions ON relationship_assertion TYPE array<string>;
DEFINE FIELD IF NOT EXISTS proposal_ids ON relationship_assertion TYPE array<string>;
DEFINE FIELD IF NOT EXISTS ontology_version ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS resolver_version ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS projection_eligible ON relationship_assertion TYPE bool;
DEFINE FIELD IF NOT EXISTS review_depth ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS explanation ON relationship_assertion TYPE string;
DEFINE FIELD IF NOT EXISTS degraded_reason ON relationship_assertion TYPE option<string>;
DEFINE FIELD IF NOT EXISTS updated_at ON relationship_assertion TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_assertion_semantic ON relationship_assertion FIELDS subject, predicate, object;
DEFINE INDEX IF NOT EXISTS idx_assertion_status ON relationship_assertion FIELDS status, projection_eligible;

DEFINE TABLE IF NOT EXISTS assertion_review SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS target_assertion ON assertion_review TYPE record<relationship_assertion>;
DEFINE FIELD IF NOT EXISTS reviewer_role ON assertion_review TYPE string;
DEFINE FIELD IF NOT EXISTS model ON assertion_review TYPE option<string>;
DEFINE FIELD IF NOT EXISTS provider ON assertion_review TYPE option<string>;
DEFINE FIELD IF NOT EXISTS path ON assertion_review TYPE option<string>;
DEFINE FIELD IF NOT EXISTS verdict ON assertion_review TYPE string;
DEFINE FIELD IF NOT EXISTS objections ON assertion_review TYPE array<string>;
DEFINE FIELD IF NOT EXISTS counterevidence ON assertion_review TYPE array<string>;
DEFINE FIELD IF NOT EXISTS alternative_predicates ON assertion_review TYPE array<string>;
DEFINE FIELD IF NOT EXISTS missing_assumptions ON assertion_review TYPE array<string>;
DEFINE FIELD IF NOT EXISTS proposed_scope ON assertion_review TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS severity ON assertion_review TYPE string;
DEFINE FIELD IF NOT EXISTS confidence ON assertion_review TYPE float;
DEFINE FIELD IF NOT EXISTS ontology_version ON assertion_review TYPE string;
DEFINE FIELD IF NOT EXISTS reviewer_policy_version ON assertion_review TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON assertion_review TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_review_target ON assertion_review FIELDS target_assertion;

DEFINE TABLE IF NOT EXISTS assertion_event SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS assertion_id ON assertion_event TYPE record<relationship_assertion>;
DEFINE FIELD IF NOT EXISTS event_type ON assertion_event TYPE string;
DEFINE FIELD IF NOT EXISTS actor ON assertion_event TYPE string;
DEFINE FIELD IF NOT EXISTS from_status ON assertion_event TYPE option<string>;
DEFINE FIELD IF NOT EXISTS to_status ON assertion_event TYPE option<string>;
DEFINE FIELD IF NOT EXISTS rationale ON assertion_event TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON assertion_event TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_assertion_event_target ON assertion_event FIELDS assertion_id, created_at;

DEFINE TABLE IF NOT EXISTS assertion_dependency TYPE RELATION SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS dependency_type ON assertion_dependency TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON assertion_dependency TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_assertion_dependency_unique ON assertion_dependency FIELDS in, out, dependency_type UNIQUE;

DEFINE TABLE IF NOT EXISTS operational_relationship SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS in ON operational_relationship TYPE record;
DEFINE FIELD IF NOT EXISTS out ON operational_relationship TYPE record;
DEFINE FIELD IF NOT EXISTS predicate ON operational_relationship TYPE string;
DEFINE FIELD IF NOT EXISTS assertion_id ON operational_relationship TYPE record<relationship_assertion>;
DEFINE FIELD IF NOT EXISTS ontology_version ON operational_relationship TYPE string;
DEFINE FIELD IF NOT EXISTS resolver_version ON operational_relationship TYPE string;
DEFINE FIELD IF NOT EXISTS projection_version ON operational_relationship TYPE string;
DEFINE FIELD IF NOT EXISTS projected_at ON operational_relationship TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_operational_assertion ON operational_relationship FIELDS assertion_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_operational_endpoints ON operational_relationship FIELDS in, out, predicate UNIQUE;
